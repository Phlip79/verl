# NGC-based environment for Nemotron 3.5 Super VL SFT and Lightning SFT/GRPO.
# The historical filename is retained so existing build commands still work.
# The base image supplies CUDA and the system toolchain. release/v0.9.0 has no
# uv.lock, so the training/rollout stack is explicitly pinned below.
# The venv intentionally shadows NGC's bundled Python packages, including Torch.

ARG BASE_IMAGE=nvcr.io/nvidia/pytorch:26.06-py3
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG VERL_COMMIT=unknown
ARG MAX_JOBS=16
ARG TORCH_CUDA_ARCH_LIST="9.0;10.0"
ARG MEGATRON_CORE_REVISION=89b28875a8d786ab41333bc60e7e8022e83e8f65
ARG MEGATRON_BRIDGE_REVISION=e97a67acbf1b7a8ae0a0e0f26c60fa9548e19bfe

LABEL org.opencontainers.image.source="https://github.com/verl-project/verl" \
      org.opencontainers.image.revision="${VERL_COMMIT}" \
      org.opencontainers.image.description="verl Nemotron 3.5 Super VL SFT and Lightning SFT/GRPO environment"

# NGC images set /etc/pip/constraint.txt globally. Native package builds in the
# pinned environment must not inherit constraints for the base image's Python
# stack, which is intentionally isolated from the project venv.
RUN touch /opt/verl-empty-constraints.txt

ENV MAX_JOBS=${MAX_JOBS} \
    NO_VCS_VERSION=1 \
    PIP_CONSTRAINT=/opt/verl-empty-constraints.txt \
    PIP_NO_CACHE_DIR=1 \
    TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST} \
    UV_HTTP_TIMEOUT=500 \
    UV_INDEX_STRATEGY=unsafe-best-match \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    VIRTUAL_ENV=/workspace/verl/.venv \
    VLLM_TARGET_DEVICE=cuda \
    PATH="/workspace/verl/.venv/bin:${PATH}"

RUN test "${VERL_COMMIT}" != unknown

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        ffmpeg \
        git \
        libibverbs-dev \
        libnuma-dev \
        librdmacm-dev \
        ninja-build \
        numactl && \
    rm -rf /var/lib/apt/lists/*

# Same installer used by the source PR's CUDA image.
COPY --from=ghcr.io/astral-sh/uv:0.11.16 /uv /uvx /bin/

WORKDIR /workspace/verl

# The build-context ignore rules keep host state and unrelated repository files
# out of the image while retaining all inputs needed to install verl.
COPY pyproject.toml setup.py README.md LICENSE Notice.txt ./
COPY docker/nemotron_3_5_lightning.overrides.txt /opt/verl-overrides.txt
COPY verl ./verl
COPY examples ./examples

# These x86_64 / Python 3.12 wheels match the source PR's CUDA 13 / Torch 2.13
# stack. The container-specific override opts out of v0.9.0's Transformers<5.11
# cap; it does not change the release branch's general dependency policy.
RUN test "$(uname -m)" = x86_64 && \
    uv venv --python python3.12 "${VIRTUAL_ENV}" && \
    uv pip install --overrides /opt/verl-overrides.txt \
        --index-url https://download.pytorch.org/whl/cu130 \
        "torch==2.13.0+cu130" "torchvision==0.28.0+cu130" "torchaudio==2.11.0+cu130" && \
    uv pip install --overrides /opt/verl-overrides.txt \
        --extra-index-url https://download.pytorch.org/whl/cu130 \
        --extra-index-url https://pypi.nvidia.com \
        ".[geo]" "vllm==0.29.0" "transformers==5.20.1" \
        "peft==0.21.0" "hydra-core==1.3.7" \
        "datasets==5.1.0" "pyarrow==26.0.0" \
        "diffusers==0.41.0" "timm==1.0.30" "open-clip-torch==3.3.0" "nvidia-resiliency-ext==0.7.0" \
        "cupy-cuda13x==14.0.1" "liger-kernel==0.8.4" "trl==0.27.0" \
        "flash-linear-attention==0.5.2" "megatron-energon==7.4.1" "nvidia-modelopt==0.48.0rc1" \
        "TransferQueue==0.1.8" \
        nvidia-mathdx onnxscript matplotlib nvtx cachetools pyzmq msgspec math-verify \
        latex2sympy2_extended ninja setuptools wheel \
        "https://github.com/verl-project/verl-wheelhouse/releases/download/apex-master-py3.12-torch2.13.0/apex-0.1-cp312-cp312-linux_x86_64.whl" \
        "https://github.com/verl-project/verl-wheelhouse/releases/download/flash-attention-v2.8.3-py3.12-torch2.13.0/flash_attn-2.8.3-cp312-cp312-linux_x86_64.whl" \
        "https://github.com/verl-project/verl-wheelhouse/releases/download/transformer-engine-v2.16.1-py3.12-torch2.13.0/transformer_engine-2.16.1-cp312-cp312-linux_x86_64.whl"

# Bridge's dependency metadata conflicts with the combined rollout stack, as
# in the source PR, so install its known runtime dependencies above and install
# Bridge itself deps-free. This matched source pair supplies Super VL's
# processor-expanded NemotronOmniModel; released Bridge 0.6.2 does not.
# Keep source builds isolated: Core needs setuptools>=80, Bridge needs <80.
RUN uv pip install --no-deps --build-constraint /opt/verl-overrides.txt \
        --extra-index-url https://download.pytorch.org/whl/cu130 \
        "megatron-core @ git+https://github.com/NVIDIA/Megatron-LM.git@${MEGATRON_CORE_REVISION}" \
        "megatron-bridge @ git+https://github.com/NVIDIA-NeMo/Megatron-Bridge.git@${MEGATRON_BRIDGE_REVISION}" && \
    CAUSAL_CONV1D_FORCE_BUILD=TRUE uv pip install \
        --no-binary :all: --no-build-isolation --no-deps \
        "causal-conv1d==1.6.2.post1" && \
    MAMBA_FORCE_BUILD=TRUE uv pip install \
        --no-binary :all: --no-build-isolation --no-deps \
        "mamba-ssm==2.3.2.post1" && \
    uv cache clean

# Fail the build if the source pins, native kernels, or Super VL wrapper are
# missing. This does not allocate model weights or require a training cluster.
RUN python - "${MEGATRON_CORE_REVISION}" "${MEGATRON_BRIDGE_REVISION}" <<'PY'
import json
import sys
from importlib.metadata import distribution, version
from pathlib import Path
from types import SimpleNamespace

import modelopt.torch
from megatron.core.ssm import mamba_mixer as mm
from verl.models.mcore.mtp_support import has_native_mtp_support, validate_nemotron_super_vl_config

expected = {
    "torch": "2.13.0+cu130",
    "transformer-engine": "2.16.1",
    "vllm": "0.29.0",
    "transformers": "5.20.1",
    "datasets": "5.1.0",
    "pyarrow": "26.0.0",
    "nvidia-modelopt": "0.48.0rc1",
    "causal-conv1d": "1.6.2.post1",
    "mamba-ssm": "2.3.2.post1",
}
actual = {name: version(name) for name in expected}
assert actual == expected, (actual, expected)
for name, revision in zip(("megatron-core", "megatron-bridge"), sys.argv[1:], strict=True):
    source = json.loads(distribution(name).read_text("direct_url.json"))
    assert source["vcs_info"]["commit_id"] == revision, (name, source)
assert mm.HAVE_MAMBA_SSM and mm.causal_conv1d_fn is not None
assert has_native_mtp_support()
validate_nemotron_super_vl_config(
    SimpleNamespace(architectures=["NemotronH_Omni_Reasoning_V3"]),
    SimpleNamespace(vanilla_mbridge=False, context_parallel_size=1, dynamic_context_parallel=False, use_fused_kernels=False),
)
for path in (
    "examples/sft/vlm/run_nemotron_3_5_super_vl_megatron.sh",
    "examples/data_preprocess/pokemon.py",
):
    assert Path(path).is_file(), path
print(actual)
PY

# Super VL SFT training, held-out evaluation, checkpoint save, and next-step
# resume were validated on 4 nodes x 8 H100 GPUs.

CMD ["bash"]
